{
  "manifest_version": 3,
  "name": "CoScribble",
  "version": "0.3.0",
  "description": "Highlight, comment on, and draw over any webpage with others live. Click the toolbar icon to turn it on for the current tab.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle CoScribble on this page"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
